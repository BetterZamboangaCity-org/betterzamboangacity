---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import BarangayHeader from '../../components/barangays/BarangayHeader.astro';
import BarangayExplorer from '../../components/barangays/BarangayExplorer';
import BarangayDetails from '../../components/barangays/barangay-details.astro';
import { fetchBarangays } from '../../lib/supabase';

const { data: allBarangays } = await fetchBarangays();

// Check if viewing a specific barangay detail
const slug = Astro.url.searchParams.get('slug');
const barangay = slug ? (allBarangays.find((b) => b.slug === slug) || null) : null;
const missingBarangay = slug !== null && !barangay;
if (missingBarangay) Astro.response.status = 404;

const title = missingBarangay
  ? 'Barangay not found | Better Zamboanga City'
  : barangay
    ? `Barangay ${barangay.name} | Better Zamboanga City`
    : 'Barangay Directory | Better Zamboanga City';
const description = missingBarangay
  ? 'The requested barangay record is unavailable. Browse the Zamboanga City barangay directory to find a listed record.'
  : barangay
    ? `View the barangay profile and listed officials for ${barangay.name}, Zamboanga City.`
    : 'Browse the Zamboanga City barangay directory by name and district, with links to barangay profiles and listed officials.';
const canonicalURL = barangay
  ? `/government/barangays?${new URLSearchParams({ slug: barangay.slug })}`
  : '/government/barangays';
---

<Layout title={title} description={description} canonicalURL={canonicalURL} noindex={missingBarangay} mainClass="grow bg-slate-50 font-sans pb-16">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 min-h-screen max-w-[1600px] w-full space-y-10">
    {missingBarangay ? (
      <section class="max-w-2xl mx-auto space-y-4 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">Barangay not found</h1>
        <p class="text-slate-600">The requested barangay record is unavailable.</p>
        <a class="inline-block text-blue-700 underline focus:outline-none focus:ring-2 focus:ring-blue-600" href="/government/barangays">Browse the barangay directory</a>
      </section>
    ) : barangay ? (
      <BarangayDetails barangay={barangay} />
    ) : (
      <Fragment>
        <BarangayHeader />
        <BarangayExplorer initialBarangays={allBarangays} client:load />
        
        <!-- Data Sources Credits -->
        <div class="mt-8 pt-6 border-t border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs font-medium text-slate-500 bg-white/50 p-6 border border-slate-200 shadow-xs">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-slate-700">
              <svg class="w-4 h-4 text-blue-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span><strong>Governance Data:</strong> Sourced from the Department of the Interior and Local Government (DILG).</span>
            </div>
            <div class="flex items-center gap-2 text-slate-700">
              <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span><strong>Demographic Data:</strong> Sourced from the Philippine Statistics Authority (PSA) 2024 POPCEN.</span>
            </div>
          </div>
          <div class="shrink-0 text-slate-500 font-bold bg-slate-100 px-4 py-2 border border-slate-200 flex items-center gap-2">
            <svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            Civic Open Data
          </div>
        </div>
      </Fragment>
    )}
  </div>
</Layout>
