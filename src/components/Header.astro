---
interface SubItem {
  name: string;
  href: string;
}

interface NavItem {
  name: string;
  href: string;
  dropdown?: SubItem[];
}

const navigation: NavItem[] = [
  {
    name: 'Zamboanga City',
    href: '/zamboanga-city/history',
    dropdown: [
      { name: 'History & Culture', href: '/zamboanga-city/history' },
      { name: 'City Officials', href: '/zamboanga-city/officials' },
      { name: 'House of Representatives', href: '/zamboanga-city/house-of-representatives' },
      { name: 'Barangay Directory', href: '/government/barangays' },
    ],
  },
  {
    name: 'Services',
    href: '/services',
    dropdown: [
      { name: 'Certificates & Vital Records', href: '/services' },
      { name: 'Business, Trade & Investment', href: '/services' },
      { name: 'Social Services & Assistance', href: '/services' },
      { name: 'Health & Wellness', href: '/services' },
      { name: 'Taxation & Payments', href: '/services' },
      { name: 'Agriculture & Economic Development', href: '/services' },
      { name: 'Infrastructure & Public Works', href: '/services' },
      { name: 'Education & Scholarship', href: '/services' },
      { name: 'Public Safety & Security', href: '/services' },
      { name: 'Environment & Natural Resources', href: '/services' },
    ],
  },
  {
    name: 'Ordinances',
    href: '/ordinances/regulatory-ordinances',
    dropdown: [
      { name: 'Regulatory Ordinances', href: '/ordinances/regulatory-ordinances' },
    ],
  },
  {
    name: 'Transparency',
    href: '/zamboanga-city/flood-control',
  },
  {
    name: 'Contact',
    href: '/contact/disaster',
  },
];

const currentPath = Astro.url.pathname;

function isItemActive(item: NavItem): boolean {
  if (item.href !== '#' && item.href !== '/' && currentPath.startsWith(item.href)) {
    return true;
  }
  if (item.href === '/' && currentPath === '/') {
    return true;
  }
  if (item.dropdown) {
    return item.dropdown.some(
      (sub) => sub.href !== '#' && currentPath.startsWith(sub.href)
    );
  }
  return false;
}
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 font-sans shadow-xs">
  <div id="header-color-bar" class="absolute top-0 left-0 h-[3px] w-full flex opacity-0 transition-opacity duration-300" aria-hidden="true">
    {['#c084fc', '#38bdf8', '#4ade80', '#475569', '#fca5a5', '#fde047'].map((color) => (
      <div class="flex-1" style={{ backgroundColor: color }} />
    ))}
  </div>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-[1600px] w-full">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-2 sm:gap-4">
      <a
        href="/"
        class="min-w-0 flex items-center gap-2 p-1 focus:outline-none focus:ring-2 focus:ring-blue-600"
        aria-label="Better Zamboanga City Homepage">
        <img src="/images/ZC.svg" alt="" class="w-8 h-8 sm:w-13 sm:h-13 shrink-0 object-contain" />
        <div class="min-w-0 leading-tight">
          <span class="block text-sm sm:text-xl font-black text-slate-900 tracking-tight">Better<span class="text-blue-600">Zamboanga</span><span class="text-amber-500 font-extrabold">City</span></span>
          <span class="text-[11px] text-slate-500 hidden sm:block font-medium">A community-run portal for Zamboangueños</span>
        </div>
      </a>

      <nav aria-label="Main Navigation" class="hidden xl:flex items-center gap-1">
        {navigation.map((item) => (
          item.dropdown ? (
            <details class="relative" data-header-disclosure>
              <summary
                class={`flex items-center gap-1 text-sm font-semibold px-3 py-2 cursor-pointer list-none focus:outline-none focus:ring-2 focus:ring-blue-600 ${isItemActive(item) ? 'text-blue-600' : 'text-slate-700 hover:text-blue-600'}`}>
                {item.name}<span aria-hidden="true">⌄</span>
              </summary>
              <ul
                class="absolute top-full left-0 w-80 bg-white border border-slate-200 shadow-2xl rounded-[4px] z-50 p-2 space-y-0.5"
                aria-label={`${item.name} links`}>
                {item.name === 'Services' && (
                  <li>
                    <a
                      href="/services"
                      class="block px-3 py-2 text-sm font-semibold rounded-[2px] hover:bg-blue-50 focus:bg-blue-50"
                    >
                      All Services
                    </a>
                  </li>
                )}
                {item.dropdown.map((subItem) => (
                  <li>
                    <a
                      href={subItem.href}
                      class={`block px-3 py-2 text-sm font-semibold rounded-[2px] hover:bg-blue-50 focus:bg-blue-50 ${currentPath === subItem.href ? 'text-blue-700' : 'text-slate-700'}`}
                    >
                      {subItem.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? 'page' : undefined}
              class={`text-sm font-semibold px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-600 ${isItemActive(item) ? 'text-blue-600' : 'text-slate-700 hover:text-blue-600'}`}>
              {item.name}
            </a>
          )
        ))}
      </nav>

      <div class="shrink-0 flex items-center gap-3">
        <a
          href="https://discord.gg/HC43M83js"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden xl:inline-flex items-center justify-center px-4 py-2.5 text-sm font-bold text-blue-600 bg-white hover:bg-slate-50 border border-slate-200 rounded-[4px] focus:outline-none focus:ring-2 focus:ring-blue-600">
          Join Now
        </a>
        <button
          id="hdr-mobile-menu-btn"
          type="button"
          class="xl:hidden p-2.5 bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 rounded-[4px] focus:outline-none focus:ring-2 focus:ring-blue-600"
          aria-expanded="false"
          aria-controls="hdr-mobile-menu"
          aria-label="Toggle navigation menu">
          <svg
            id="hdr-menu-icon"
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            id="hdr-close-icon"
            class="w-5 h-5 hidden"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <nav
    id="hdr-mobile-menu"
    aria-label="Mobile Navigation"
    class="hidden absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-2xl xl:hidden overflow-y-auto">
    <div class="p-4 space-y-2">
      {navigation.map((item) => (
        item.dropdown ? (
          <details data-header-disclosure>
            <summary
              class={`flex items-center justify-between py-2.5 px-2 text-sm font-bold cursor-pointer list-none rounded-[4px] hover:bg-slate-50 focus:ring-2 focus:ring-blue-600 ${isItemActive(item) ? 'text-blue-600' : 'text-slate-800'}`}
            >
              {item.name}<span aria-hidden="true">⌄</span>
            </summary>
            <ul class="pl-3 py-1 space-y-1 border-l-2 border-blue-400 bg-slate-50 rounded-[4px] my-1">
              {item.name === 'Services' && (
                <li>
                  <a
                    href="/services"
                    class="block py-2 px-3 text-xs font-semibold text-slate-700 hover:text-blue-600 focus:bg-blue-50"
                  >
                    All Services
                  </a>
                </li>
              )}
              {item.dropdown.map((subItem) => (
                <li>
                  <a
                    href={subItem.href}
                    class="block py-2 px-3 text-xs font-semibold text-slate-700 hover:text-blue-600 focus:bg-blue-50"
                  >
                    {subItem.name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : (
          <a
            href={item.href}
            class="block py-2.5 px-2 text-sm font-bold text-slate-800 hover:text-blue-600 focus:bg-blue-50"
          >
            {item.name}
          </a>
        )
      ))}
      <a
        href="https://discord.gg/HC43M83js"
        target="_blank"
        rel="noopener noreferrer"
        class="block px-3 py-3 text-center text-sm font-bold text-blue-600 border border-slate-200 rounded-[4px]">
        Join Now
      </a>
    </div>
  </nav>
</header>

<script>
  let cleanupHeader: (() => void) | undefined;

  function initHeader() {
    cleanupHeader?.();
    const header = document.querySelector('header');
    const button = document.getElementById('hdr-mobile-menu-btn');
    const menu = document.getElementById('hdr-mobile-menu');
    const menuIcon = document.getElementById('hdr-menu-icon');
    const closeIcon = document.getElementById('hdr-close-icon');
    const colorBar = document.getElementById('header-color-bar');
    if (!header || !button || !menu) return;

    const controller = new AbortController();
    const options = { signal: controller.signal };
    let previousOverflow: string | undefined;
    const closeMenu = (restoreFocus = false) => {
      button.setAttribute('aria-expanded', 'false');
      menu.classList.add('hidden');
      menuIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      menu.querySelectorAll('details').forEach((details) => {
        details.open = false;
      });
      if (previousOverflow !== undefined) {
        document.body.style.overflow = previousOverflow;
        previousOverflow = undefined;
      }
      if (restoreFocus) button.focus();
    };
    const updateScroll = () => colorBar?.classList.toggle('opacity-0', window.scrollY <= 20);
    updateScroll();
    window.addEventListener('scroll', updateScroll, { ...options, passive: true });
    button.addEventListener('click', () => {
      if (button.getAttribute('aria-expanded') === 'true') return closeMenu();
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      button.setAttribute('aria-expanded', 'true');
      menu.classList.remove('hidden');
      menu.style.maxHeight = `${Math.max(0, window.innerHeight - menu.getBoundingClientRect().top)}px`;
      menuIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
    }, options);
    header.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const disclosure = (event.target as HTMLElement).closest('details');
      if (disclosure?.open) {
        disclosure.open = false;
        disclosure.querySelector('summary')?.focus();
      } else if (button.getAttribute('aria-expanded') === 'true') closeMenu(true);
    }, options);
    header.addEventListener('focusout', (event) => {
      if (!header.contains(event.relatedTarget as Node)) {
        closeMenu();
        header.querySelectorAll('details').forEach((details) => {
        details.open = false;
      });
      }
    }, options);
    header.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) closeMenu();
    }, options);
    document.addEventListener('click', (event) => {
      if (!header.contains(event.target as Node)) {
        closeMenu();
        header.querySelectorAll('details').forEach((details) => {
        details.open = false;
      });
      }
    }, options);
    header.addEventListener('toggle', (event) => {
      const target = event.target as HTMLDetailsElement;
      if (!target.open) return;
      header.querySelectorAll('details').forEach((details) => {
        if (details !== target) details.open = false;
      });
    }, { ...options, capture: true });
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1280) closeMenu();
      else if (button.getAttribute('aria-expanded') === 'true') menu.style.maxHeight = `${Math.max(0, window.innerHeight - menu.getBoundingClientRect().top)}px`;
    }, options);
    document.addEventListener('astro:before-swap', () => closeMenu(), options);
    cleanupHeader = () => {
      closeMenu();
      controller.abort();
    };
  }
  document.addEventListener('astro:page-load', initHeader);
</script>
